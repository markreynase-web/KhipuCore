{
  "permissions": {
    "allow": [
      "Bash(where python *)",
      "Bash(where python3 *)",
      "Bash(where node *)",
      "Bash(where npx *)",
      "Bash(npm run *)",
      "Bash(python -m http.server 3000)",
      "Bash(curl -s http://localhost:3001/api/salud)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/pages/login.html)",
      "Bash(npx --yes serve -l 3000)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:3000/pages/login.html)",
      "Bash(curl -s -o /dev/null -w \"frontend:%{http_code}\\\\n\" http://localhost:3000/)",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ]
  }
}
