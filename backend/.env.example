# Copia este archivo a .env y ajusta los valores a tu instalación de PostgreSQL.
# Ejemplo local: crea la base con `createdb dashboard_core` y usa el usuario/clave
# de tu instalación (o los que te dé tu proveedor si usas Neon/Supabase/Railway).
#
# Si usas Supabase: Project Settings → Database → Connection string → "URI".
# Para un backend Node de larga duración (no serverless) usa el puerto 5432
# (conexión directa), no el 6543 (pooler transaccional) -- 5432 soporta bien
# los BEGIN/COMMIT de import CSV. Ejemplo:
# DATABASE_URL=postgresql://postgres:tu-password@db.tuproyecto.supabase.co:5432/postgres
DATABASE_URL=postgresql://usuario:password@localhost:5432/dashboard_core

# Supabase (y casi todo proveedor administrado) exige SSL. Déjalo así salvo
# que conectes a un Postgres local sin SSL, en cuyo caso pon PGSSL=false.
PGSSL=true

API_PORT=3001
# Nota: se usa API_PORT (no PORT) a propósito. Muchas instalaciones de Windows/Node
# ya tienen una variable de entorno del sistema llamada PORT (de otros proyectos,
# ej. React/Next.js), y esa le gana a lo que pongas aquí — causa que el backend
# arranque en un puerto que no esperas.

# Origen permitido para CORS: la URL donde sirves el frontend (index.html/pages/*.html).
# Con `python -m http.server 8000` en la raíz del proyecto, sería http://localhost:8000
CORS_ORIGIN=http://localhost:8000

# Cualquier texto largo y aleatorio, para firmar los tokens de sesión.
# Genera uno rápido con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Fase D: Khipu AI. API key de la cuenta de Anthropic (console.anthropic.com)
# -- sin esto, el widget de Khipu AI responde con un error amigable en vez de
# tumbar el resto del backend (ver routes/khipuAi.js). Cada pregunta hace una
# llamada real y facturada a Claude ("generación en vivo", sin caché).
ANTHROPIC_API_KEY=sk-ant-...

# Recuperación de contraseña: la URL pública donde vive el frontend (sin
# barra al final), para armar el enlace que va en el correo
# (FRONTEND_URL/pages/restablecer-password.html?token=...). En producción es
# https://khipu-core.vercel.app; en local, donde sirvas los archivos estáticos
# (ver CORS_ORIGIN arriba).
FRONTEND_URL=http://localhost:8000

# SMTP para el correo de "Restablece tu contraseña" (ver src/mailer.js).
# Funciona con cualquier proveedor SMTP -- no hace falta un SDK especial:
#   - Gmail: smtp.gmail.com, puerto 587. SMTP_PASSWORD debe ser una
#     "contraseña de aplicación" (myaccount.google.com/apppasswords), NO tu
#     contraseña normal -- Gmail la rechaza si tienes verificación en 2 pasos.
#   - Un servicio transaccional (Brevo, Resend, SendGrid, Mailtrap para
#     pruebas...): usan sus propias credenciales SMTP, revisa su panel.
# Si dejas estas variables vacías, KhipuCore NO manda el correo de verdad --
# en su lugar escribe el enlace de recuperación en el log del servidor, para
# poder probar el flujo completo sin credenciales reales mientras desarrollas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=KhipuCore <no-responder@khipucore.com>
